# Copy to .env and fill in. NEVER commit .env.

# --- WithSecure Elements API client (read-only scope is used) -----------------------------
# Leave empty to run the demo (seed) only.
ELEMENTS_CLIENT_ID=
ELEMENTS_CLIENT_SECRET=

# --- Database ------------------------------------------------------------------------------
# Generate strong values, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-postgres
GRAFANA_DB_PASSWORD=change-me-grafana-reader

# --- Grafana -------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
GRAFANA_PORT=3000
# 127.0.0.1 = this host only. Use 0.0.0.0 to reach Grafana from the LAN (prefer HTTPS + SSO).
GRAFANA_BIND_ADDRESS=127.0.0.1

# --- Collector (optional; see docs/configuration.md for all settings) ---------------------
# PULSE_CONFIG_FILE=/config/config.yaml
# Comma-separated organization UUIDs. Empty = default organization of the API client.
# PULSE_ORGANIZATIONS__IDS=
# PULSE_ORGANIZATIONS__DISCOVER=false
# PULSE_LOG_LEVEL=INFO
