          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT day::timestamptz AS time, protection_status_overview AS metric, sum(count) AS value FROM device_status_daily WHERE organization_id::text IN (${org:sqlstring}) AND $__timeFilter(day::timestamptz) GROUP BY 1, 2 ORDER BY 1"
