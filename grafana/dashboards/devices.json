          "rawSql": "SELECT d.name AS \"Device\", COALESCE(o.name, d.organization_id::text) AS \"Organization\", d.type AS \"Type\", d.os_name AS \"OS\", d.client_version AS \"Agent\", d.protection_status_overview AS \"Overview\", d.protection_status AS \"Status\", d.malware_state AS \"Malware\", d.firewall_state AS \"Firewall\", d.patch_overall_state AS \"Updates\", d.online AS \"Online\", d.status_update_at AS \"Last seen\", a.outdated AS \"Outdated agent\" FROM v_devices_current d LEFT JOIN organizations o ON o.id = d.organization_id LEFT JOIN v_device_agent_status a USING (device_id) WHERE d.organization_id::text IN (${org:sqlstring}) AND d.type IN (${dtype:sqlstring}) AND d.state = 'active' AND (d.protection_status_overview <> 'allOk' OR a.outdated OR d.os_end_of_life OR d.status_update_at < now() - interval '7 days') ORDER BY CASE d.protection_status_overview WHEN 'critical' THEN 0 WHEN 'isolated' THEN 1 WHEN 'warning' THEN 2 ELSE 3 END, d.status_update_at NULLS FIRST LIMIT 500"
        }
