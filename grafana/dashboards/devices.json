    {
      "type": "barchart",
      "title": "Protection status",
      "description": "",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "elements-pulse-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "elements-pulse-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COALESCE(protection_status_overview, 'unknown') AS label, count(*) AS devices FROM v_devices_current WHERE organization_id::text IN (${org:sqlstring}) AND type IN (${dtype:sqlstring}) AND state = 'active' GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisBorderShow": false,
            "gradientMode": "none",
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2a78d6",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "label"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "allOk": {
                        "color": "#0ca30c",
                        "index": 0,
                        "text": "allOk"
                      },
                      "warning": {
                        "color": "#fab219",
                        "index": 1,
                        "text": "warning"
                      },
                      "critical": {
                        "color": "#d03b3b",
                        "index": 2,
                        "text": "critical"
                      },
                      "inactive": {
                        "color": "#8e959e",
                        "index": 3,
                        "text": "inactive"
                      },
                      "isolated": {
                        "color": "#6250d6",
                        "index": 4,
                        "text": "isolated"
                      },
                      "unknown": {
                        "color": "#8e959e",
                        "index": 5,
                        "text": "unknown"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 40,
        "stacking": "none",
        "colorByField": "label"
      }
    },
    {
      "type": "timeseries",
      "interval": "1h",
      "title": "Protection status trend (daily)",
      "description": "One snapshot per day, all device types.",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "elements-pulse-pg"
