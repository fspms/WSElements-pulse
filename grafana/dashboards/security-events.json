          "rawSql": "SELECT e.persistence_ts AS \"Time\", COALESCE(o.name, e.organization_id::text) AS \"Organization\", upper(e.engine_group) AS \"Group\", e.engine AS \"Engine\", e.severity AS \"Severity\", e.action AS \"Action\", COALESCE(e.device_name, e.target_name) AS \"Device / target\", e.alert_type AS \"Alert type\", e.message AS \"Message\" FROM security_events e LEFT JOIN organizations o ON o.id = e.organization_id WHERE e.organization_id::text IN (${org:sqlstring}) AND e.engine_group IN (${group:sqlstring}) AND e.severity IN (${severity:sqlstring}) AND e.engine IN (${engine:sqlstring}) AND $__timeFilter(e.persistence_ts) ORDER BY e.persistence_ts DESC LIMIT 500"
