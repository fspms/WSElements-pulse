          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "elements-pulse-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), CASE WHEN status IS NULL THEN 'network error' WHEN status = 429 THEN '429' WHEN status >= 500 THEN '5xx' WHEN status >= 400 THEN '4xx' ELSE '2xx' END AS metric, count(*) AS value FROM api_requests WHERE (organization_id IS NULL OR organization_id::text IN (${org:sqlstring})) AND $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
