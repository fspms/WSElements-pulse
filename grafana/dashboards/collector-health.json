    {
      "type": "table",
      "title": "Collectors",
      "description": "",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "elements-pulse-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "elements-pulse-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT collector AS \"Collector\", COALESCE(organization_name, organization_id::text) AS \"Organization\", CASE WHEN stale THEN 'stale' WHEN consecutive_failures > 0 THEN 'failing' ELSE 'ok' END AS \"State\", last_success_at AS \"Last success\", cursor_ts AS \"Cursor\", consecutive_failures AS \"Failures\", interval_seconds AS \"Interval\", last_error AS \"Last error\" FROM v_collector_health WHERE organization_id::text IN (${org:sqlstring}) ORDER BY stale DESC, consecutive_failures DESC, collector"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "stale": {
                        "color": "#d03b3b",
                        "index": 0,
                        "text": "stale"
                      },
                      "failing": {
                        "color": "#fab219",
                        "index": 1,
                        "text": "failing"
                      },
                      "ok": {
                        "color": "#0ca30c",
                        "index": 2,
                        "text": "ok"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Interval"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
