    {
      "type": "stat",
      "title": "Median time to close",
      "description": "Approximation: last update time of closed incidents minus creation.",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "elements-pulse-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
