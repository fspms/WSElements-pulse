    {
      "type": "stat",
      "title": "False positive rate",
      "description": "Share of closed incidents resolved as false positive.",
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "elements-pulse-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "elements-pulse-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE resolution IN ('falsePositive', 'autoFalsePositive')) / NULLIF(count(*) FILTER (WHERE status = 'closed'), 0) FROM incidents WHERE organization_id::text IN (${org:sqlstring}) AND risk_level IN (${risk:sqlstring}) AND status IN (${status:sqlstring}) AND $__timeFilter(created_at)"
