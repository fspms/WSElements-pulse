      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "elements-pulse-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM updated_at - created_at)) FROM incidents WHERE organization_id::text IN (${org:sqlstring}) AND risk_level IN (${risk:sqlstring}) AND status IN (${status:sqlstring}) AND status = 'closed' AND $__timeFilter(created_at)"
